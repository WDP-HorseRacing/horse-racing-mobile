{
  "name": "horseracing-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:i18n",
    "build:injury-mapper": "node scripts/build-injury-mapper.mjs",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "^58.0.10",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  }
}
