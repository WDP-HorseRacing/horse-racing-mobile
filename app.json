{
  "expo": {
    "name": "HorseRacing",
    "slug": "horseracing-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "horseracing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horseracing.mobile"
    },
    "android": {
      "package": "com.horseracing.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
