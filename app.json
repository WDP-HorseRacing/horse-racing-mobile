{
  "expo": {
    "name": "HorseRacing",
    "slug": "horseracing-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "horseracing",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horseracing.mobile"
    },
    "android": {
      "package": "com.horseracing.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router", "expo-video"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
